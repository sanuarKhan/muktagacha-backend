generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  VENDOR
  PROVIDER
  ADMIN
}

enum Vertical {
  MARKETPLACE
  PHARMACY
  SERVICES
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
}

// Buyer submits a TrxID after paying the vendor's bKash/Nagad number
// directly; vendor (or admin) manually confirms the payment actually
// landed. This is the SkodePay pattern: money never touches our
// platform, we only verify. See v3 architecture plan, Section 6, Path A.
enum PaymentVerificationStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(BUYER)
  area         String?
  ward         String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  organizations Organization[]
  orders        Order[]

  @@index([area, ward])
  @@map("users")
}

model Organization {
  id                String         @id @default(uuid())
  ownerUserId       String
  owner             User           @relation(fields: [ownerUserId], references: [id])
  name              String
  logoUrl           String?        @db.Text
  vertical          Vertical
  area              String?
  ward              String?
  deliveryRadiusKm  Decimal?       @db.Decimal(4, 1)
  approvalStatus    ApprovalStatus @default(PENDING)
  createdAt         DateTime       @default(now())

  // Where the vendor receives payment (shown to buyers at checkout).
  // Buyer pays this number directly via bKash/Nagad app, then submits
  // the TrxID on the order for the vendor to verify.
  bkashNumber       String?
  nagadNumber       String?

  // Vendor's own Cloudinary account (optional). If set, product/shop
  // images this vendor uploads go to THEIR Cloudinary storage/bandwidth
  // quota instead of ours - keeps platform image costs at zero as the
  // vendor base grows. apiSecret is encrypted at rest (AES-256-GCM, see
  // src/crypto/secret-crypto.service.ts) - never stored or returned as
  // plaintext outside the upload-signing request itself.
  cloudinaryCloudName    String?
  cloudinaryApiKey       String?
  cloudinaryApiSecretEnc String? @db.Text

  listings  Product[]
  orders    Order[]
  marketingContacts  MarketingContact[]
  marketingCampaigns MarketingCampaign[]

  @@index([ownerUserId])
  @@index([area, ward, vertical])
  @@map("organizations")
}

// Managed taxonomy - admin creates/edits these; vendors pick from the
// list instead of typing free text. Self-referencing tree so e.g.
// Clothing > Men's > Panjabi works without a separate subcategory table.
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  vertical  Vertical
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  products  Product[]

  @@index([vertical, parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])

  name           String
  slug           String
  description    String?       @db.Text
  basePrice      Decimal       @db.Decimal(10, 2)
  hasVariants    Boolean       @default(false)

  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]

  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, isActive])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Only created when Product.hasVariants = true. One row per purchasable
// combination (e.g. "Red / Large") with its own optional price override
// and stock count. optionValues is a flexible JSON map ({"size":"L",
// "color":"Red"}) rather than a rigid attribute schema, since every
// vertical has different variant dimensions (clothing: size/color;
// groceries: weight; services: duration).
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String?
  optionValues  Json
  priceOverride Decimal? @db.Decimal(10, 2)
  stockCount    Int      @default(0)
  isActive      Boolean  @default(true)

  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id             String        @id @default(uuid())
  buyerId        String
  buyer          User          @relation(fields: [buyerId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  createdAt      DateTime      @default(now())

  // Buyer-submitted proof of payment for BKASH/NAGAD orders (irrelevant
  // for CASH_ON_DELIVERY, which stays NOT_SUBMITTED/unused).
  paymentTrxId          String?
  paymentVerification   PaymentVerificationStatus @default(NOT_SUBMITTED)
  paymentVerifiedAt     DateTime?

  items OrderItem[]

  @@index([buyerId])
  @@index([organizationId, status])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  price     Decimal         @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// A vendor's own uploaded customer phone list for SMS marketing.
// Deliberately scoped per-organization (not shared across vendors) —
// each shop owns and manages its own contact list, same as the
// bKash/Nagad numbers pattern.
model MarketingContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phone          String
  name           String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("marketing_contacts")
}

// One SMS blast sent to some/all of a vendor's contact list. Tracks
// delivery counts so the vendor sees real results (not a fire-and-forget
// black box) — sentCount/failedCount are updated as the send completes.
model MarketingCampaign {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message        String         @db.Text
  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  sentAt         DateTime?

  @@index([organizationId])
  @@map("marketing_campaigns")
}
