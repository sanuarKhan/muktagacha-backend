generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  VENDOR
  PROVIDER
  ADMIN
  RIDER
}

enum Vertical {
  MARKETPLACE
  PHARMACY
  SERVICES
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Separate from ApprovalStatus (which just gates "can this shop go live
// at all") - verification is an OPTIONAL extra trust signal a vendor can
// earn by proving who they really are, shown to buyers as a badge. A shop
// can be APPROVED (live, selling) but still UNVERIFIED if the owner never
// submitted ID/license docs - this is deliberate, not a bug: verification
// is opt-in trust-building, not a launch gate, matching the client's
// "they will remain unverified" framing rather than being blocked.
enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  SKODEPAY
}

// Buyer submits a TrxID after paying the vendor's bKash/Nagad number
// directly; vendor (or admin) manually confirms the payment actually
// landed. This is the SkodePay pattern: money never touches our
// platform, we only verify. See v3 architecture plan, Section 6, Path A.
enum PaymentVerificationStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum PrescriptionStatus {
  NOT_REQUIRED
  PENDING_UPLOAD
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(BUYER)
  area         String?
  ward         String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  organizations Organization[]
  orders        Order[]
  deliveriesAsRider Order[] @relation("RiderDeliveries")
  riderProfile  RiderProfile?

  conversationsAsBuyer Conversation[]      @relation("ConversationsAsBuyer")
  messagesSent         Message[]           @relation("MessagesSent")
  shopQuestionsAsked   ShopQuestion[]      @relation("QuestionsAsked")
  shopQuestionReplies  ShopQuestionReply[] @relation("QuestionRepliesAuthored")
  groupsCreated        Group[]             @relation("GroupsCreated")
  groupMemberships     GroupMember[]       @relation("GroupMemberships")
  groupTopicsCreated   GroupTopic[]        @relation("GroupTopicsCreated")
  groupPostsAuthored   GroupPost[]         @relation("GroupPostsAuthored")
  directConversationsAsA DirectConversation[] @relation("DirectConversationsAsA")
  directConversationsAsB DirectConversation[] @relation("DirectConversationsAsB")
  directMessagesSent     DirectMessage[]      @relation("DirectMessagesSent")
  replyVotesCast         ReplyVote[]          @relation("ReplyVotesCast")
  ordersReceivedAsGift   Order[]              @relation("OrdersReceivedAsGift")
  organizationsVerified  Organization[]       @relation("OrganizationsVerifiedBy")
  fraudFlagsReviewed     FraudFlag[]          @relation("FraudFlagsReviewed")
  prescriptionsReviewed  Order[]              @relation("PrescriptionsReviewed")
  serviceRequestsAsBuyer ServiceRequest[]     @relation("ServiceRequestsAsBuyer")

  @@index([area, ward])
  @@map("users")
}

model Organization {
  id                String         @id @default(uuid())
  ownerUserId       String
  owner             User           @relation(fields: [ownerUserId], references: [id])
  name              String
  logoUrl           String?        @db.Text
  vertical          Vertical
  area              String?
  ward              String?
  deliveryRadiusKm  Decimal?       @db.Decimal(4, 1)
  approvalStatus    ApprovalStatus @default(PENDING)
  createdAt         DateTime       @default(now())

  // Vendor trust verification - OPTIONAL, separate from approvalStatus.
  // Vendor uploads at least one of tradeLicenseUrl/nidUrl (both allowed,
  // at least one mandatory to move past UNVERIFIED), admin reviews and
  // approves/rejects. VERIFIED shops get a visible badge on their
  // storefront so buyers always know who they're really buying from -
  // the core trust requirement for a community-based marketplace.
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  tradeLicenseUrl     String?            @db.Text
  nidUrl              String?            @db.Text
  verificationNote    String?            @db.Text
  verifiedAt          DateTime?
  verifiedById        String?
  verifiedBy          User?              @relation("OrganizationsVerifiedBy", fields: [verifiedById], references: [id])

  // Shop's physical location, shown on the free Leaflet/OpenStreetMap
  // map on their storefront page (no Google Maps API key needed - see
  // google-maps-free-alternative note in riders.service.ts). Optional:
  // a vendor who hasn't pinned their location yet just shows no map.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Where the vendor receives payment (shown to buyers at checkout).
  // Buyer pays this number directly via bKash/Nagad app, then submits
  // the TrxID on the order for the vendor to verify.
  bkashNumber       String?
  nagadNumber       String?

  // Vendor's own Cloudinary account (optional). If set, product/shop
  // images this vendor uploads go to THEIR Cloudinary storage/bandwidth
  // quota instead of ours - keeps platform image costs at zero as the
  // vendor base grows. apiSecret is encrypted at rest (AES-256-GCM, see
  // src/crypto/secret-crypto.service.ts) - never stored or returned as
  // plaintext outside the upload-signing request itself.
  cloudinaryCloudName    String?
  cloudinaryApiKey       String?
  cloudinaryApiSecretEnc String? @db.Text

  // Vendor's own SkodePay account (optional, same opt-in pattern as
  // Cloudinary above). When set, checkout for this vendor's orders can
  // create a real SkodePay hosted-payment-link transaction instead of
  // (or alongside) the manual bKash/Nagad-number + TrxID flow. The API
  // key is encrypted at rest with the same AES-256-GCM service used for
  // the Cloudinary secret - never stored or returned as plaintext
  // outside the one request that actually calls SkodePay's API.
  skodePayApiKeyEnc String? @db.Text
  skodePayEnabled   Boolean @default(false)

  listings  Product[]
  orders    Order[]
  marketingContacts  MarketingContact[]
  marketingCampaigns MarketingCampaign[]
  conversations      Conversation[]
  shopQuestions      ShopQuestion[]
  serviceRequests    ServiceRequest[]

  @@index([ownerUserId])
  @@index([area, ward, vertical])
  @@map("organizations")
}

// Managed taxonomy - admin creates/edits these; vendors pick from the
// list instead of typing free text. Self-referencing tree so e.g.
// Clothing > Men's > Panjabi works without a separate subcategory table.
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  vertical  Vertical
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  products  Product[]
  serviceRequests ServiceRequest[]

  @@index([vertical, parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])

  name           String
  slug           String
  description    String?       @db.Text
  basePrice      Decimal       @db.Decimal(10, 2)
  hasVariants    Boolean       @default(false)

  // Pharmacy vertical: a vendor marks a specific medicine as requiring a
  // prescription (e.g. antibiotics) - not every pharmacy item needs one
  // (hand sanitizer, vitamins). Meaningless/ignored for MARKETPLACE and
  // SERVICES products. If ANY item in a cart requires one, the whole
  // order needs a prescription photo before it can be placed.
  requiresPrescription Boolean @default(false)

  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]

  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, isActive])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Only created when Product.hasVariants = true. One row per purchasable
// combination (e.g. "Red / Large") with its own optional price override
// and stock count. optionValues is a flexible JSON map ({"size":"L",
// "color":"Red"}) rather than a rigid attribute schema, since every
// vertical has different variant dimensions (clothing: size/color;
// groceries: weight; services: duration).
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String?
  optionValues  Json
  priceOverride Decimal? @db.Decimal(10, 2)
  stockCount    Int      @default(0)
  isActive      Boolean  @default(true)

  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id             String        @id @default(uuid())
  buyerId        String
  buyer          User          @relation(fields: [buyerId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  createdAt      DateTime      @default(now())

  // Gift orders: buyer PAYS, recipient RECEIVES - like sending a gift to a
  // partner/friend from any shop on the platform. recipientId is nullable;
  // when null the order is a normal self-purchase (buyer = recipient,
  // implicitly). giftSenderAnonymous controls whether the recipient sees
  // the buyer's real name or "A Secret Admirer" - buyer's choice per gift.
  isGift              Boolean  @default(false)
  recipientId         String?
  recipient           User?    @relation("OrdersReceivedAsGift", fields: [recipientId], references: [id])
  giftMessage         String?  @db.Text
  giftSenderAnonymous Boolean  @default(false)

  // Free-text delivery address - needed for gift orders where the buyer is
  // entering the RECIPIENT's address directly (buyer's own saved area/ward
  // doesn't apply here), but also useful generally for any order where a
  // map pin alone isn't precise enough (building/floor/landmark notes).
  deliveryAddressText String? @db.Text

  // Pharmacy vertical: set when ANY item in the order has
  // Product.requiresPrescription = true. Buyer must upload a photo of a
  // real prescription before the pharmacy will confirm the order -
  // mirrors the existing manual-payment-verification pattern (buyer
  // submits proof, vendor/admin reviews and approves/rejects) rather than
  // inventing a new review mechanism.
  requiresPrescription   Boolean               @default(false)
  prescriptionImageUrl   String?               @db.Text
  prescriptionStatus     PrescriptionStatus    @default(NOT_REQUIRED)
  prescriptionReviewedAt DateTime?
  prescriptionReviewedById String?
  prescriptionReviewedBy  User?               @relation("PrescriptionsReviewed", fields: [prescriptionReviewedById], references: [id])
  prescriptionRejectionNote String?            @db.Text

  // Buyer-submitted proof of payment for BKASH/NAGAD orders (irrelevant
  // for CASH_ON_DELIVERY, which stays NOT_SUBMITTED/unused).
  paymentTrxId          String?
  paymentVerification   PaymentVerificationStatus @default(NOT_SUBMITTED)
  paymentVerifiedAt     DateTime?

  // Local delivery assignment. Muktagacha has no national courier API -
  // riders are real people the admin/vendor hires directly, assigned
  // per-order. riderId is nullable: most orders start unassigned, admin
  // or vendor assigns a rider once the order is confirmed and ready to
  // go out. deliveredAt is set when the rider marks the order COMPLETED.
  riderId      String?
  rider        User?     @relation("RiderDeliveries", fields: [riderId], references: [id])
  deliveryNote String?   @db.Text
  deliveredAt  DateTime?

  // When paymentMethod is SKODEPAY: the real hosted-checkout transaction
  // created on the vendor's own SkodePay account. skodePayRef is
  // SkodePay's 27-digit transaction reference (used to check status and
  // to match the webhook callback back to this order).
  skodePayRef         String?
  skodePayCheckoutUrl String? @db.Text

  // Buyer's delivery drop-off pin, set optionally at checkout (e.g. by
  // tapping their location on the map) so the rider has an exact point
  // instead of just a free-text area/ward. Nullable - plenty of orders
  // will still just use the buyer's area/ward text address.
  deliveryLatitude  Decimal? @db.Decimal(10, 7)
  deliveryLongitude Decimal? @db.Decimal(10, 7)

  items OrderItem[]
  fraudFlags FraudFlag[]

  @@index([buyerId])
  @@index([recipientId])
  @@index([organizationId, status])
  @@index([riderId, status])
  @@map("orders")
}

// Automated fraud/abuse detection for orders - rule-based, NOT a blind
// auto-block. Every flag just adds a row here and the order keeps
// proceeding normally; an admin reviews the queue and decides whether to
// contact the buyer, cancel, or dismiss the flag as a false positive. See
// FraudDetectionService for the actual rules (rapid repeat orders,
// repeated COD cancellations/no-shows, mismatched payment TrxID reused
// across orders, etc).
model FraudFlag {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason     String
  severity   FraudSeverity @default(LOW)
  createdAt  DateTime @default(now())

  // Admin review - resolved stays false until an admin looks at it and
  // either dismisses or acts on it. Not a hard block on anything; purely
  // a visibility/review queue.
  resolved     Boolean  @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?    @relation("FraudFlagsReviewed", fields: [resolvedById], references: [id])
  resolutionNote String? @db.Text

  @@index([orderId])
  @@index([resolved, severity])
  @@map("fraud_flags")
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  price     Decimal         @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// A vendor's own uploaded customer phone list for SMS marketing.
// Deliberately scoped per-organization (not shared across vendors) —
// each shop owns and manages its own contact list, same as the
// bKash/Nagad numbers pattern.
model MarketingContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phone          String
  name           String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("marketing_contacts")
}

// One SMS blast sent to some/all of a vendor's contact list. Tracks
// delivery counts so the vendor sees real results (not a fire-and-forget
// black box) — sentCount/failedCount are updated as the send completes.
model MarketingCampaign {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message        String         @db.Text
  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  sentAt         DateTime?

  @@index([organizationId])
  @@map("marketing_campaigns")
}

// A rider's public profile: self-signup (same pattern as vendors), admin
// approves before they can receive deliveries. vehicleType/coverage are
// shown to admin/vendors when deciding whether to assign a delivery.
// avgRating/completedDeliveries are denormalized counters, updated each
// time a new DeliveryRating is created - cheap reads on every order-
// assignment screen instead of an aggregate query every time.
model RiderProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id])
  vehicleType         String?        // e.g. "Bicycle", "Motorcycle", "On foot"
  coverageArea        String?        // e.g. "Muktagacha Bazar, Ward 1-3"
  approvalStatus      ApprovalStatus @default(PENDING)
  avgRating           Decimal?       @db.Decimal(3, 2)
  completedDeliveries Int            @default(0)
  createdAt           DateTime       @default(now())

  ratings DeliveryRating[]

  @@index([approvalStatus])
  @@map("rider_profiles")
}

// One rating per completed delivery, left by the buyer. Average is
// recomputed onto RiderProfile.avgRating whenever a new one comes in -
// same denormalization reasoning as above.
model DeliveryRating {
  id        String       @id @default(uuid())
  riderId   String
  rider     RiderProfile @relation(fields: [riderId], references: [id])
  orderId   String       @unique
  rating    Int          // 1-5
  comment   String?      @db.Text
  createdAt DateTime     @default(now())

  @@index([riderId])
  @@map("delivery_ratings")
}

// =============================================================================
// CHAT SYSTEM
// =============================================================================
// Two separate surfaces, matching the real-world rule the business wants:
//   1. Public shop Q&A board — anyone can post a question on a vendor's
//      storefront page; the vendor (or anyone) can reply; visible to all
//      visitors. This is the "common place where everyone can chat" / local
//      community discussion board under each shop.
//   2. Private conversation — a 1:1 thread between ONE buyer and ONE vendor
//      organization. Enforced rule: only a BUYER can create a new
//      conversation (open the first message to a shop). A vendor can only
//      reply inside conversations that already exist — they can never
//      initiate a new conversation to a buyer who hasn't messaged first.
//      This is enforced in the service layer (ChatService.sendMessage),
//      not just the UI, since a malicious/careless vendor account could
//      otherwise call the API directly.
// =============================================================================

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  buyerId        String
  buyer          User         @relation("ConversationsAsBuyer", fields: [buyerId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]

  // One conversation per (shop, buyer) pair — reopening a chat with the
  // same shop continues the existing thread rather than forking a new one.
  @@unique([organizationId, buyerId])
  @@index([organizationId])
  @@index([buyerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Public board: one question per row, with its own flat list of replies.
// Kept deliberately simple (flat replies, no nested threading) since this
// is a small-town local marketplace, not a forum — depth adds UI complexity
// with little real benefit at this scale.
model ShopQuestion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  askerId        String
  asker          User         @relation("QuestionsAsked", fields: [askerId], references: [id])
  body           String       @db.Text
  // Author identity is ALWAYS stored (askerId above) for moderation/abuse
  // accountability - isAnonymous only controls what's shown to OTHER users
  // ("Anonymous" instead of the real name). Never actually anonymous at
  // the data layer, which is the correct tradeoff for a real platform.
  isAnonymous    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  replies ShopQuestionReply[]

  @@index([organizationId, createdAt])
  @@map("shop_questions")
}

model ShopQuestionReply {
  id            String       @id @default(uuid())
  questionId    String
  question      ShopQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User         @relation("QuestionRepliesAuthored", fields: [authorId], references: [id])
  body          String       @db.Text
  isAnonymous   Boolean      @default(false)
  score         Int          @default(0)
  createdAt     DateTime     @default(now())

  votes ReplyVote[]

  @@index([questionId, createdAt])
  @@index([questionId, score])
  @@map("shop_question_replies")
}

// =============================================================================
// COMMUNITY GROUPS — Discord-style: any user can create a group (e.g. "Bazar
// Road Residents", "Bike Buy/Sell Mukta"), each group has its own topics
// (channels), members join/leave freely, anyone in the group can post in any
// of its topics. This is the broader "build the local community" layer,
// separate from and in addition to the per-shop Q&A board and private
// buyer-vendor chat above — groups are not tied to any one vendor.
// =============================================================================

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  area        String?
  ward        String?
  creatorId   String
  creator     User     @relation("GroupsCreated", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())

  members GroupMember[]
  topics  GroupTopic[]

  @@index([area, ward])
  @@map("groups")
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation("GroupMemberships", fields: [userId], references: [id])
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// A "topic" is a channel within a group (Discord-style: one group, many
// topics members can post under — e.g. "General", "Buy & Sell", "Events").
model GroupTopic {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  creatorId String
  creator   User     @relation("GroupTopicsCreated", fields: [creatorId], references: [id])
  createdAt DateTime @default(now())

  posts GroupPost[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("group_topics")
}

model GroupPost {
  id          String     @id @default(uuid())
  topicId     String
  topic       GroupTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation("GroupPostsAuthored", fields: [authorId], references: [id])
  body        String     @db.Text
  isAnonymous Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([topicId, createdAt])
  @@map("group_posts")
}

// =============================================================================
// PEER-TO-PEER MESSAGING (customer <-> customer)
// =============================================================================
// Separate from Conversation (buyer<->vendor) on purpose: the business rule
// is the OPPOSITE here - either side can start a chat freely, no "only one
// side can initiate" restriction. Any two users (most commonly two buyers
// who met through a Group or a shop's Q&A board) can message each other
// directly, like a normal messenger.
// =============================================================================

model DirectConversation {
  id         String   @id @default(uuid())
  // Always stored with userAId < userBId (enforced in the service layer)
  // so a conversation between the same two people can never be created
  // twice in either direction.
  userAId    String
  userA      User     @relation("DirectConversationsAsA", fields: [userAId], references: [id])
  userBId    String
  userB      User     @relation("DirectConversationsAsB", fields: [userBId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User               @relation("DirectMessagesSent", fields: [senderId], references: [id])
  body           String             @db.Text
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

// =============================================================================
// Q&A ANSWER CREDIBILITY — Reddit-style upvote/downvote
// =============================================================================
// Exactly the Reddit pattern the client asked for: someone asks a question,
// the community answers, and OTHER community members vote each answer up or
// down so the best real answer rises to the top by net score (upvotes minus
// downvotes) - not a star-rating on a person, a live-ranked trust signal on
// each individual answer. One vote per (user, reply); voting the opposite
// direction flips it, voting the same direction again removes it (clicking
// upvote twice = un-voting, same as Reddit). `score` is denormalized onto
// ShopQuestionReply for cheap sort-by-best-answer queries (same pattern as
// RiderProfile.avgRating elsewhere in this schema).
// =============================================================================

enum VoteValue {
  UP
  DOWN
}

model ReplyVote {
  id        String            @id @default(uuid())
  replyId   String
  reply     ShopQuestionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("ReplyVotesCast", fields: [userId], references: [id])
  value     VoteValue
  createdAt DateTime          @default(now())

  @@unique([replyId, userId])
  @@index([replyId])
  @@map("reply_votes")
}

// =============================================================================
// SERVICES VERTICAL — request/quote booking flow
// =============================================================================
// Deliberately NOT the same cart-and-checkout flow as Marketplace/Pharmacy.
// A buyer can't add "AC repair" to a cart at a fixed price the way they add
// a shirt - the real-world flow (matching Sheba.xyz, the validated local
// reference model named in the original plan) is: buyer describes the
// problem -> provider reviews and sends a price quote -> buyer accepts ->
// provider visits and does the work -> both sides confirm completion.
// Payment happens the same way as everything else in Phase 1 (cash or the
// vendor's own bKash/Nagad number), just AFTER the work, not upfront.

enum ServiceRequestStatus {
  REQUESTED // buyer submitted, waiting on provider to quote
  QUOTED // provider sent a price, waiting on buyer to accept/decline
  ACCEPTED // buyer accepted the quote, provider should come do the work
  IN_PROGRESS // provider marked they've started/arrived
  COMPLETED // work done, both sides agree
  DECLINED // provider declined to take this job
  CANCELLED // buyer cancelled before acceptance
}

model ServiceRequest {
  id             String               @id @default(uuid())
  buyerId        String
  buyer          User                 @relation("ServiceRequestsAsBuyer", fields: [buyerId], references: [id])
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  categoryId     String?
  category       Category?            @relation(fields: [categoryId], references: [id])

  // What the buyer actually needs done, in their own words - services
  // have no fixed catalog of exact tasks the way products do (every AC
  // repair job is a little different), so this is the core of the request.
  description String @db.Text
  photoUrl    String? @db.Text // optional photo of the problem (e.g. a leaking pipe)

  // Where the work needs to happen - a service visit needs an address,
  // not a delivery drop-off point (though the same lat/lng pin pattern
  // works for "find me" convenience).
  addressText String? @db.Text
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)

  // Buyer's preferred time window - free text ("tomorrow morning",
  // "this weekend") rather than a rigid calendar slot system, matching
  // the plan's explicit sequencing (real calendar-based slot scheduling
  // is Phase 1.5, not Phase 1 - see plan Section 3.2).
  preferredTime String?

  status ServiceRequestStatus @default(REQUESTED)

  // Provider's quote - set when status moves to QUOTED. Nullable until
  // then since the buyer doesn't know the price when they first describe
  // the problem (the whole point of a quote-based flow).
  quotedPrice   Decimal? @db.Decimal(10, 2)
  quoteNote     String?  @db.Text
  quotedAt      DateTime?

  paymentMethod PaymentMethod?
  paymentVerification   PaymentVerificationStatus @default(NOT_SUBMITTED)
  paymentTrxId          String?
  paymentVerifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  @@index([buyerId])
  @@index([organizationId, status])
  @@map("service_requests")
}
