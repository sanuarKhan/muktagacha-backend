DATABASE_URL="postgresql://postgres:***@localhost:5432/muktagacha?schema=public"
JWT_SECRET="replace-with-a-real-random-secret-before-deploy"
PORT=3000

# AES-256-GCM key used to encrypt vendor Cloudinary API secrets at rest.
# Must be exactly 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY="replace-with-a-real-32-byte-base64-key-before-deploy"

# Shared fallback Cloudinary account, used for vendors who haven't
# connected their own. Get these from cloudinary.com dashboard (free tier).
CLOUDINARY_FALLBACK_CLOUD_NAME=""
CLOUDINARY_FALLBACK_API_KEY=""
CLOUDINARY_FALLBACK_API_SECRET=""

# SMS gateway (httpSMS.com) - powers order-status texts AND vendor
# marketing campaigns. Same provider already used on the DMC/English
# Village project. Without these, SMS sends are logged and reported as
# failed (honest no-op), nothing breaks.
#   HTTPSMS_API_KEY - from https://httpsms.com/settings
#   HTTPSMS_FROM    - the phone number registered with httpSMS to send from
HTTPSMS_API_KEY=""
HTTPSMS_FROM=""
