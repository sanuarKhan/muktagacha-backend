# Muktagacha backend — environment variables
# Copy to .env for local dev, and set these in your host's dashboard
# (Render / Railway / Fly) for production.

# ---------------------------------------------------------------------------
# REQUIRED — the app will NOT start without these
# ---------------------------------------------------------------------------

# Postgres connection string.
# Supabase users: use the TRANSACTION POOLER URI (port 6543), not the direct
# 5432 one — pooled hosts and serverless need the pooler.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Signs and verifies every auth token. Generate with: openssl rand -hex 32
# In production the app refuses to boot if this is missing — without it,
# anyone could forge an admin token.
JWT_SECRET=

# AES-256-GCM key used to encrypt vendor Cloudinary API secrets at rest.
# MUST base64-decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The app throws on startup if this is unset or the wrong length.
SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — browser requests fail without it
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins. Must be the EXACT origin,
# scheme included, no trailing slash. e.g.
#   https://muktagacha.vercel.app,https://www.muktagacha.com
# If this is wrong or unset in production, the backend still responds to
# curl/server-to-server calls just fine, but every browser request is blocked
# with a "CORS policy" error — which looks exactly like "login is broken".
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# OPTIONAL — features degrade gracefully if unset
# ---------------------------------------------------------------------------

# Port to listen on. Most hosts (Render/Railway) set this automatically.
PORT=3456

# SMS notifications via httpSMS. Without these, SMS is skipped silently.
HTTPSMS_API_KEY=
HTTPSMS_FROM=

# Platform-wide Cloudinary fallback, used when a vendor hasn't connected
# their own Cloudinary account. Without these, image upload falls back to
# base64-in-database.
CLOUDINARY_FALLBACK_CLOUD_NAME=
CLOUDINARY_FALLBACK_API_KEY=
CLOUDINARY_FALLBACK_API_SECRET=
